{
  "name": "friendlabs-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src public/*.css public/hratkov/*.css tests astro.config.mjs",
    "format:check": "prettier --check src public/*.css public/hratkov/*.css tests astro.config.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:deploy": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
