---
interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'cs' | 'sk';
  hratkov?: boolean;
}

const { title, description, lang = 'en', hratkov = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={hratkov ? '#eef6ff' : '#fbfaf7'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/hratkov/games/match.webp', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles.css" />
    {hratkov && <link rel="stylesheet" href="/hratkov/hratkov.css" />}
    {hratkov && (
      <link
        rel="preload"
        href="/hratkov/fonts/Baloo2-ExtraBold.ttf"
        as="font"
        type="font/ttf"
        crossorigin
      />
    )}
    {hratkov && (
      <link
        rel="preload"
        href="/hratkov/fonts/Nunito-Bold.ttf"
        as="font"
        type="font/ttf"
        crossorigin
      />
    )}
    {hratkov && (
      <link
        rel="preload"
        href="/hratkov/fonts/Nunito-ExtraBold.ttf"
        as="font"
        type="font/ttf"
        crossorigin
      />
    )}
  </head>
  <body class:list={{ 'hratkov-site': hratkov }}>
    <a href="#main" class="skip-link">
      {lang === 'cs' ? 'Přejít na obsah' : 'Skip to content'}
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Friendlabs — home">
        <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="12" cy="16" r="10" fill="#4f6df5" />
          <circle cx="21" cy="16" r="10" fill="#ff8a5c" fill-opacity="0.85" />
        </svg>
        Friendlabs
      </a>
      <nav aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
        <a href="/hratkov/" aria-current={Astro.url.pathname === '/hratkov/' ? 'page' : undefined}>
          Hrátkov
        </a>
        <a href="/support/" aria-current={Astro.url.pathname === '/support/' ? 'page' : undefined}>
          {lang === 'cs' ? 'Podpora' : 'Support'}
        </a>
        <a
          href="/privacy/"
          aria-current={Astro.url.pathname.startsWith('/privacy/') ? 'page' : undefined}
        >
          {lang === 'cs' ? 'Soukromí' : 'Privacy'}
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1" class:list={{ 'hratkov-main': hratkov }}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} Friendlabs <span aria-hidden="true">·</span>{' '}
        <a href="/hratkov/">Hrátkov</a> <span aria-hidden="true">·</span>{' '}
        <a href="/privacy/hratkov/">{lang === 'cs' ? 'Soukromí aplikace' : 'App privacy'}</a>{' '}
        <span aria-hidden="true">·</span>{' '}
        <a href="/hratkov/podminky/">{lang === 'cs' ? 'Podmínky' : 'Terms'}</a>{' '}
        <span aria-hidden="true">·</span>{' '}
        <a href="/support/">{lang === 'cs' ? 'Podpora' : 'Support'}</a>
      </p>
    </footer>
  </body>
</html>
