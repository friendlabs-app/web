---
interface Props {
  lang: 'en' | 'cs' | 'sk';
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/hratkov/', label: 'Hrátkov', current: path === '/hratkov/' },
  {
    href: '/support/',
    label: lang === 'cs' ? 'Podpora' : 'Support',
    current: path === '/support/',
  },
  {
    href: '/privacy/',
    label: lang === 'cs' ? 'Soukromí' : 'Privacy',
    current: path.startsWith('/privacy/'),
  },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label={lang === 'cs' ? 'Friendlabs — úvod' : 'Friendlabs — home'}>
    <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="12" cy="16" r="10" fill="#4f6df5" />
      <circle cx="21" cy="16" r="10" fill="#ff8a5c" fill-opacity="0.85" />
    </svg>
    Friendlabs
  </a>
  <nav aria-label={lang === 'cs' ? 'Hlavní navigace' : 'Main navigation'}>
    {links.map((link) => (
      <a href={link.href} aria-current={link.current ? 'page' : undefined}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px 24px;
    max-width: 1256px;
    margin: 0 auto;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    font-family: system-ui, sans-serif;
    line-height: 1.25;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    color: var(--text);
    font:
      700 1.05rem / 1.25 system-ui,
      sans-serif;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .brand svg {
    display: block;
    flex-shrink: 0;
  }
  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    justify-self: end;
    width: min(100%, 17.5rem);
  }
  nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: max(44px, 2.5em);
    padding: 0 4px;
    color: var(--muted);
    font:
      700 0.85rem / 1.25 system-ui,
      sans-serif;
    overflow-wrap: anywhere;
    text-align: center;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .site-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 16px 20px;
    }
    nav {
      justify-self: stretch;
      width: 100%;
    }
  }
</style>
