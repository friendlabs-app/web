---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { privacy } from '../../data/privacy';
const languages = [...privacy].sort(
  (a, b) => ['cs', 'sk', 'en'].indexOf(a.id) - ['cs', 'sk', 'en'].indexOf(b.id),
);
---

<SiteLayout
  title="Hrátkov — zásady ochrany soukromí"
  description="Zásady soukromí Hrátkova v češtině, slovenštině a angličtině. Nastavení dítěte zůstává v zařízení, volitelné předplatné ověřuje RevenueCat."
>
  <article class="page">
    <h1>Soukromí v Hrátkově</h1>
    <nav class="policy-links" aria-label="Jazyk zásad soukromí">
      <a href="#cs">Česky</a>
      <a href="#sk">Slovensky</a>
      <a href="#en">English</a>
    </nav>
    {languages.map((language) => (
      <section
        id={language.id}
        lang={language.id}
        class="policy-language"
        aria-labelledby={`title-${language.id}`}
      >
        <h2 id={`title-${language.id}`}>{language.title}</h2>
        <p class="updated">{language.updated}</p>
        <p class="policy-summary">
          <strong>{language.summary}</strong>
        </p>
        {language.sections.map((section) => (
          <section>
            <h3>{section.heading}</h3>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
      </section>
    ))}
    <h2>Související informace</h2>
    <ul>
      <li>
        <a href="https://www.revenuecat.com/privacy">RevenueCat privacy policy</a>
      </li>
      <li>
        <a href="https://www.revenuecat.com/dpa">RevenueCat Data Processing Addendum</a>
      </li>
      <li>
        <a href="https://www.apple.com/legal/privacy/">Apple privacy policy</a>
      </li>
      <li>
        <a href="https://policies.google.com/privacy">Google privacy policy</a>
      </li>
      <li>
        <a href="/soukromi/web/">Soukromí tohoto webu</a>
      </li>
    </ul>
    <p>
      <a href="mailto:friendlabs.app@gmail.com">friendlabs.app@gmail.com</a> ·{' '}
      <a href="/">Hrátkov</a> · <a href="/podpora/">Podpora</a>
    </p>
  </article>
</SiteLayout>
