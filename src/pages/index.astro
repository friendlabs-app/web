---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Friendlabs" description="Friendlabs — apps made by friends. Booking tools, games for kids, and tabletop adventures.">
<section class="hero">
      <h1>Apps made by <span class="grad">friends</span>.</h1>
      <p class="lede">We are a two-person studio building small, useful, and playful apps - from booking tools to games for kids and tabletop adventures.</p>
    </section>

    <section id="apps" class="apps">
      <h2>Our apps</h2>
      <div class="app-grid">
        <article class="app-card"><img src="/hratkov/animals/puppy.webp" width="112" height="112" alt="A puppy from Hrátkov" style="border-radius:24px;display:block;margin-bottom:18px"/><h3>Hrátkov</h3><p>Twelve playful games for little explorers aged 2–5. Animals, dinosaurs, colours, and small discoveries.</p><p style="margin-top:16px"><a href="/hratkov/">Meet Hrátkov →</a></p><p style="margin-top:8px;font-size:.85rem">In development for iOS &amp; Android</p></article>
      </div>
    </section>
</SiteLayout>
